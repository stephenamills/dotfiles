{
  "description": "Global Codex lifecycle hooks.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/plan_critic.py",
            "timeout": 600,
            "statusMessage": "Reviewing proposed plan"
          }
        ]
      }
    ]
  }
}
