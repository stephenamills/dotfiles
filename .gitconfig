[alias]
	p = "!f() { git commit -m \"$*\" && git push; }; f"
	dp = "!f() { git -C \"$HOME/projects/zsh/dotfiles\" p \"$@\"; }; f"

[core]
	editor = code --wait
	excludesfile = /Users/steph/.gitignore
	pager = delta

[credential "https://github.com"]
	helper = !gh auth git-credential

[credential]
	helper = osxkeychain

[delta]
	hyperlinks = true
	navigate = true

[diff]
	colorMoved = default

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[github]
	user = stephenamills

[init]
	defaultBranch = main

[interactive]
	diffFilter = delta --color-only

[lfs "customtransfer.xet"]
	path = git-xet
	args = transfer
	concurrent = true

[merge]
	conflictstyle = diff3

[user]
	name = stephenamills
	email = stephmills468@gmail.com


