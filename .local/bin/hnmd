#!/usr/bin/env python3
"""Render a Hacker News story or comment tree as clean Markdown."""

from __future__ import annotations

import argparse
import concurrent.futures
import html
import json
import re
import subprocess
import sys
import unicodedata
import urllib.error
import urllib.parse
import urllib.request
from datetime import UTC, datetime
from pathlib import Path
from typing import Any


API_URL = "https://hacker-news.firebaseio.com/v0/item/{item_id}.json"


class HnmdError(Exception):
    """An error that should be shown without a traceback."""


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Render a Hacker News thread as GitHub-Flavored Markdown.",
        epilog="By default, hnmd copies the complete thread to the clipboard.",
    )
    parser.add_argument(
        "-f",
        "--file",
        action="store_true",
        help="write TITLE.md in the current directory instead",
    )
    parser.add_argument("item", metavar="URL_OR_ITEM_ID")
    return parser.parse_args()


def item_id_from(value: str) -> int:
    if value.isascii() and value.isdecimal():
        return int(value)

    query = urllib.parse.urlsplit(value).query
    ids = urllib.parse.parse_qs(query).get("id", [])
    if len(ids) == 1 and ids[0].isascii() and ids[0].isdecimal():
        return int(ids[0])
    raise HnmdError(f"invalid Hacker News item id: {value}")


def fetch_item(item_id: int) -> dict[str, Any] | None:
    request = urllib.request.Request(
        API_URL.format(item_id=item_id),
        headers={"User-Agent": "hnmd/1.0"},
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            item = json.load(response)
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
        raise HnmdError(f"could not fetch Hacker News item {item_id}: {exc}") from exc

    if item is None:
        return None
    if not isinstance(item, dict) or item.get("id") is None:
        raise HnmdError(f"unexpected response for Hacker News item {item_id}")
    return item


def fetch_thread(item_id: int) -> tuple[dict[str, Any], dict[int, dict[str, Any]]]:
    root = fetch_item(item_id)
    if root is None:
        raise HnmdError(f"Hacker News item {item_id} does not exist")

    items = {item_id: root}
    seen = {item_id}
    pending = list(root.get("kids") or [])
    seen.update(pending)

    # Firebase exposes each comment as its own item. Fetch each breadth of the
    # tree concurrently, then reconstruct the original `kids` order locally.
    with concurrent.futures.ThreadPoolExecutor(max_workers=16) as executor:
        while pending:
            futures = {executor.submit(fetch_item, child_id): child_id for child_id in pending}
            pending = []
            for future in concurrent.futures.as_completed(futures):
                child = future.result()
                if child is None:
                    continue
                child_id = int(child["id"])
                items[child_id] = child
                for grandchild_id in child.get("kids") or []:
                    if grandchild_id not in seen:
                        seen.add(grandchild_id)
                        pending.append(grandchild_id)

    return root, items


def escaped(value: Any) -> str:
    return html.escape(str(value), quote=True)


def fenced_code(value: Any) -> str:
    return str(value).replace("<pre><code>", '<pre><code class="hnmd-code">')


def document_title(item: dict[str, Any]) -> str:
    if item.get("type") == "story" or item.get("title") is not None:
        return str(item.get("title") or f"Hacker News item {item['id']}")
    return f"Hacker News comment {item['id']}"


def timestamp_for(item: dict[str, Any]) -> str:
    timestamp = item.get("time")
    if timestamp is None:
        return "unknown date"
    try:
        return datetime.fromtimestamp(timestamp, UTC).isoformat(timespec="seconds").replace(
            "+00:00", "Z"
        )
    except (OSError, OverflowError, TypeError, ValueError):
        return "unknown date"


def render_html(
    item: dict[str, Any],
    items: dict[int, dict[str, Any]],
) -> str:
    def comment_meta(comment: dict[str, Any]) -> str:
        author = escaped(comment.get("by") or "[deleted]")
        created_at = escaped(timestamp_for(comment))
        return f"<p><b>{author}</b> — {created_at}</p>\n"

    def node(comment: dict[str, Any]) -> str:
        parts = ["<li>\n", comment_meta(comment)]
        parts.extend((fenced_code(comment.get("text") or "<p>[deleted]</p>"), "\n"))
        children = [items[child_id] for child_id in comment.get("kids") or [] if child_id in items]
        if children:
            rendered = "\n".join(node(child) for child in children)
            parts.extend(("<ul>\n", rendered, "\n</ul>\n"))
        parts.append("</li>")
        return "".join(parts)

    title = document_title(item)
    if item.get("type") != "story" and item.get("title") is None:
        return f"<h1>{escaped(title)}</h1>\n<ul>\n{node(item)}\n</ul>\n"

    parts = [f"<h1>{escaped(title)}</h1>\n"]
    if item.get("url"):
        url = escaped(item["url"])
        parts.append(f'<p><a href="{url}">{url}</a></p>\n')
    points = escaped(item.get("score") or 0)
    author = escaped(item.get("by") or "[deleted]")
    created_at = escaped(timestamp_for(item))
    parts.append(f"<p>{points} points / {author} / {created_at}</p>\n")
    parts.extend((fenced_code(item.get("text") or ""), "\n"))

    children = [items[child_id] for child_id in item.get("kids") or [] if child_id in items]
    if children:
        rendered = "\n".join(node(child) for child in children)
        parts.extend(("<ul>\n", rendered, "\n</ul>\n"))
    return "".join(parts)


def render_markdown(source_html: str) -> str:
    try:
        result = subprocess.run(
            ["pandoc", "-f", "html", "-t", "gfm-raw_html", "--wrap=none"],
            input=source_html,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except FileNotFoundError as exc:
        raise HnmdError("pandoc is required but was not found") from exc
    if result.returncode != 0:
        detail = result.stderr.strip() or f"pandoc exited with status {result.returncode}"
        raise HnmdError(f"could not render Markdown: {detail}")
    return result.stdout


def filename_for(title: str) -> str:
    # Preserve normal title punctuation (including the example's apostrophe and
    # question mark), changing only path separators and troublesome controls.
    title = title.replace("/", " - ")
    title = "".join(" " if unicodedata.category(char) == "Cc" else char for char in title)
    title = re.sub(r"\s+", " ", title).strip()
    if not title or title in {".", ".."}:
        title = "Hacker News item"

    # Common filesystems cap one path component at 255 UTF-8 bytes.
    encoded = title.encode("utf-8")[:240]
    while True:
        try:
            title = encoded.decode("utf-8")
            break
        except UnicodeDecodeError:
            encoded = encoded[:-1]
    return f"{title.rstrip()}.md"


def copy_to_clipboard(markdown: str) -> None:
    try:
        result = subprocess.run(
            ["pbcopy"],
            input=markdown,
            text=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            check=False,
        )
    except FileNotFoundError as exc:
        raise HnmdError("pbcopy is required but was not found") from exc
    if result.returncode != 0:
        detail = result.stderr.strip() or f"pbcopy exited with status {result.returncode}"
        raise HnmdError(f"could not copy to the clipboard: {detail}")


def main() -> int:
    args = parse_args()
    try:
        item_id = item_id_from(args.item)
        item, items = fetch_thread(item_id)
        source_html = render_html(item, items)
        markdown = render_markdown(source_html)

        if args.file:
            output = Path.cwd() / filename_for(document_title(item))
            output.write_text(markdown, encoding="utf-8")
            print(output)
        else:
            copy_to_clipboard(markdown)
            comment_count = sum(child.get("type") == "comment" for child in items.values())
            print(f"Copied {document_title(item)!r} to the clipboard ({comment_count} comments).")
        return 0
    except (HnmdError, OSError) as exc:
        print(f"hnmd: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
